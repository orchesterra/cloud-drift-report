{
  "_about": "Shared .driftignore cases. cloud-drift-report and OrchesTerra both run these; change them in both. expect: ignored | kept, plus kept_paths when attribute rules drop some changes.",
  "cases": [
    {"name": "type wildcard", "rules": ["aws_iam_role.*"],
     "finding": {"type": "aws_iam_role", "address": "aws_iam_role.app", "physical_id": "arn:aws:iam::111111111111:role/app", "action": "changed outside IaC", "paths": ["assume_role_policy"]},
     "expect": "ignored"},
    {"name": "bare type", "rules": ["aws_iam_role"],
     "finding": {"type": "aws_iam_role", "address": "ci-deployer", "physical_id": "arn:aws:iam::111111111111:role/ci-deployer", "action": "not in IaC"},
     "expect": "ignored"},
    {"name": "other type untouched", "rules": ["aws_iam_role.*"],
     "finding": {"type": "aws_iam_policy", "address": "aws_iam_policy.app", "physical_id": "", "action": "changed outside IaC", "paths": ["policy"]},
     "expect": "kept"},
    {"name": "driftctl id glob on bucket name", "rules": ["aws_s3_bucket.cloudtrail-logs-*"],
     "finding": {"type": "aws_s3_bucket", "address": "cloudtrail-logs-111111111111", "physical_id": "arn:aws:s3:::cloudtrail-logs-111111111111", "action": "not in IaC"},
     "expect": "ignored"},
    {"name": "terraform resource name inside a module", "rules": ["aws_sqs_queue.jobs"],
     "finding": {"type": "aws_sqs_queue", "address": "module.workers.aws_sqs_queue.jobs[0]", "physical_id": "https://sqs.us-east-1.amazonaws.com/111111111111/jobs", "action": "deleted outside IaC"},
     "expect": "ignored"},
    {"name": "id with escaped dots", "rules": ["aws_s3_bucket.logs\\.example\\.com"],
     "finding": {"type": "aws_s3_bucket", "address": "logs.example.com", "physical_id": "arn:aws:s3:::logs.example.com", "action": "not in IaC"},
     "expect": "ignored"},
    {"name": "id with plain dots", "rules": ["aws_s3_bucket.logs.example.com"],
     "finding": {"type": "aws_s3_bucket", "address": "logs.example.com", "physical_id": "arn:aws:s3:::logs.example.com", "action": "not in IaC"},
     "expect": "ignored"},
    {"name": "last part of an ARN", "rules": ["aws_lambda_function.legacy-*"],
     "finding": {"type": "aws_lambda_function", "address": "aws_lambda_function.old", "physical_id": "arn:aws:lambda:us-east-1:111111111111:function:legacy-report", "action": "changed outside IaC", "paths": ["memory_size"]},
     "expect": "ignored"},
    {"name": "cloudformation type and logical id", "rules": ["AWS::SQS::Queue.*DLQ"],
     "finding": {"type": "AWS::SQS::Queue", "address": "JobsDLQ", "physical_id": "https://sqs.us-east-1.amazonaws.com/111111111111/jobs-dlq", "action": "changed outside IaC", "paths": ["/MessageRetentionPeriod"]},
     "expect": "ignored"},
    {"name": "negation after wildcard", "rules": ["aws_iam_role.*", "!aws_iam_role.prod-admin"],
     "finding": {"type": "aws_iam_role", "address": "prod-admin", "physical_id": "arn:aws:iam::111111111111:role/prod-admin", "action": "not in IaC"},
     "expect": "kept"},
    {"name": "later line wins over negation", "rules": ["!aws_iam_role.prod-admin", "aws_iam_role.*"],
     "finding": {"type": "aws_iam_role", "address": "prod-admin", "physical_id": "arn:aws:iam::111111111111:role/prod-admin", "action": "not in IaC"},
     "expect": "ignored"},
    {"name": "tag key and value", "rules": ["tag:ManagedBy=karpenter"],
     "finding": {"type": "aws_instance", "address": "i-0abc", "physical_id": "i-0abc", "action": "not in IaC", "tags": {"ManagedBy": "karpenter"}},
     "expect": "ignored"},
    {"name": "tag value differs", "rules": ["tag:ManagedBy=karpenter"],
     "finding": {"type": "aws_instance", "address": "i-0abc", "physical_id": "i-0abc", "action": "not in IaC", "tags": {"ManagedBy": "terraform"}},
     "expect": "kept"},
    {"name": "tag key only, glob value", "rules": ["tag:temporary", "tag:Team=data-*"],
     "finding": {"type": "aws_s3_bucket", "address": "scratch", "physical_id": "arn:aws:s3:::scratch", "action": "not in IaC", "tags": {"Team": "data-platform"}},
     "expect": "ignored"},
    {"name": "attribute rule drops all changes", "rules": ["aws_instance.worker.tags"],
     "finding": {"type": "aws_instance", "address": "aws_instance.worker", "physical_id": "i-0abc", "action": "changed outside IaC", "paths": ["tags.LastPatched", "tags_all.LastPatched"]},
     "expect": "kept_paths", "kept_paths": ["tags_all.LastPatched"]},
    {"name": "attribute rule keeps the rest", "rules": ["aws_instance.i-0abc.tags.LastPatched"],
     "finding": {"type": "aws_instance", "address": "aws_instance.worker", "physical_id": "i-0abc", "action": "changed outside IaC", "paths": ["tags.LastPatched", "instance_type"]},
     "expect": "kept_paths", "kept_paths": ["instance_type"]},
    {"name": "attribute rule with wildcard id and list index", "rules": ["aws_security_group.*.ingress"],
     "finding": {"type": "aws_security_group", "address": "aws_security_group.web", "physical_id": "sg-0abc", "action": "changed outside IaC", "paths": ["ingress[1]"]},
     "expect": "ignored"},
    {"name": "cloudformation property path", "rules": ["AWS::EC2::SecurityGroup.WebSG.SecurityGroupIngress"],
     "finding": {"type": "AWS::EC2::SecurityGroup", "address": "WebSG", "physical_id": "sg-0abc", "action": "changed outside IaC", "paths": ["/SecurityGroupIngress/1", "/Tags/0/Value"]},
     "expect": "kept_paths", "kept_paths": ["/Tags/0/Value"]},
    {"name": "attribute rule never hides a deleted resource", "rules": ["aws_instance.worker.tags"],
     "finding": {"type": "aws_instance", "address": "aws_instance.worker", "physical_id": "i-0abc", "action": "deleted outside IaC"},
     "expect": "kept"},
    {"name": "comments and blank lines", "rules": ["# a comment", "", "aws_sns_topic.alerts   # inline note"],
     "finding": {"type": "aws_sns_topic", "address": "aws_sns_topic.alerts", "physical_id": "arn:aws:sns:us-east-1:111111111111:alerts", "action": "changed outside IaC", "paths": ["display_name"]},
     "expect": "ignored"}
  ]
}
