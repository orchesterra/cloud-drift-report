{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "cloud-drift-report",
          "version": "0.9.1",
          "semanticVersion": "0.9.1",
          "informationUri": "https://github.com/orchesterra/cloud-drift-report",
          "rules": [
            {
              "id": "drift/changed-outside-iac",
              "name": "ChangedOutsideIaC",
              "shortDescription": {
                "text": "Resource changed outside IaC"
              },
              "fullDescription": {
                "text": "The live resource no longer matches its Terraform state or CloudFormation template: someone changed it in the console, CLI or another tool. Put the change in code, or revert it."
              },
              "helpUri": "https://github.com/orchesterra/cloud-drift-report#readme",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "drift",
                  "iac"
                ]
              }
            },
            {
              "id": "drift/deleted-outside-iac",
              "name": "DeletedOutsideIaC",
              "shortDescription": {
                "text": "Resource deleted outside IaC"
              },
              "fullDescription": {
                "text": "The resource is in Terraform state or a CloudFormation stack but no longer exists in the cloud."
              },
              "helpUri": "https://github.com/orchesterra/cloud-drift-report#readme",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "drift",
                  "iac"
                ]
              }
            },
            {
              "id": "drift/not-in-iac",
              "name": "NotInIaC",
              "shortDescription": {
                "text": "Resource not in IaC"
              },
              "fullDescription": {
                "text": "The resource exists in the AWS account but no Terraform state file or CloudFormation stack checked lists it. Import it into Terraform, or delete it if nobody needs it."
              },
              "helpUri": "https://github.com/orchesterra/cloud-drift-report#readme",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "drift",
                  "iac"
                ]
              }
            },
            {
              "id": "drift/idle-not-in-iac",
              "name": "IdleNotInIaC",
              "shortDescription": {
                "text": "Idle resource not in IaC"
              },
              "fullDescription": {
                "text": "The resource is in no IaC and looks idle while it still bills."
              },
              "helpUri": "https://github.com/orchesterra/cloud-drift-report#readme",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "drift",
                  "iac"
                ]
              }
            },
            {
              "id": "drift/aws-created",
              "name": "AwsCreatedResource",
              "shortDescription": {
                "text": "Resource AWS created itself"
              },
              "fullDescription": {
                "text": "AWS created this resource (a default VPC, a service-linked role, ...). Reported because of --strict."
              },
              "helpUri": "https://github.com/orchesterra/cloud-drift-report#readme",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "drift",
                  "iac"
                ]
              }
            },
            {
              "id": "drift/idle-in-iac",
              "name": "IdleInIaC",
              "shortDescription": {
                "text": "Idle resource in IaC"
              },
              "fullDescription": {
                "text": "The resource is managed by IaC but looks idle while it still bills."
              },
              "helpUri": "https://github.com/orchesterra/cloud-drift-report#readme",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "drift",
                  "iac"
                ]
              }
            },
            {
              "id": "drift/end-of-life",
              "name": "EndOfLife",
              "shortDescription": {
                "text": "Version past or near end of life"
              },
              "fullDescription": {
                "text": "The resource runs an engine, Kubernetes or runtime version that AWS has retired, bills extended support for, or retires within 90 days. Upgrade it."
              },
              "helpUri": "https://github.com/orchesterra/cloud-drift-report#readme",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "drift",
                  "iac"
                ]
              }
            }
          ]
        }
      },
      "automationDetails": {
        "id": "cloud-drift-report/aws/"
      },
      "results": [
        {
          "ruleId": "drift/not-in-iac",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "HIGH: ci-deploy-user (global) (aws_iam_user) not in IaC: arn:aws:iam::111111111111:user/ci-deploy-user is in no state file or stack checked. Exists in AWS but no state file or stack checked lists it; likely created in the console, the CLI or another tool."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "aws/global/aws_iam_user"
                }
              },
              "logicalLocations": [
                {
                  "name": "ci-deploy-user",
                  "kind": "resource",
                  "fullyQualifiedName": "arn:aws:iam::111111111111:user/ci-deploy-user"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "driftFindingHash/v1": "ddbc4c21794e084581dbd20de861d0d9e3f3bfb0f711d7671fd46a8bde4086e2"
          },
          "properties": {
            "severity": "high",
            "resourceType": "aws_iam_user",
            "address": "ci-deploy-user",
            "action": "not in IaC",
            "physicalId": "arn:aws:iam::111111111111:user/ci-deploy-user",
            "location": "global"
          }
        },
        {
          "ruleId": "drift/not-in-iac",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "HIGH: temp-debug-sg (us-east-1) (aws_security_group) not in IaC: sg-0a1b2c3d4e5f60718 is in no state file or stack checked. Exists in AWS but no state file or stack checked lists it; likely created in the console, the CLI or another tool."
